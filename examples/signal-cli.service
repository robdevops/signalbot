# An example unit for signal-cli, so that signalbot (systemd or Docker) can
# reach it on 127.0.0.1:7583. Edit User= and the path in ExecStart. For the
# Unix socket instead, which only the bot's group can use, see docs/SOCKET.md.
[Unit]
Description=signal-cli daemon
After=network-online.target
Wants=network-online.target

[Service]
# The user that owns signal-cli's data (your account keys), by default in
# ~/.local/share/signal-cli. Keep that directory at mode 0700.
User=YOUR_USER
# --tcp listens on this host only. Any local user can connect to it, and so
# control the Signal account: on a shared host use the Unix socket instead.
# --no-receive-stdout keeps received messages out of the journal; the bot gets
# them over the connection.
ExecStart=/usr/local/bin/signal-cli -o json daemon --tcp 127.0.0.1:7583 --no-receive-stdout
Restart=on-failure

[Install]
WantedBy=multi-user.target
