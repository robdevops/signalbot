# Unix socket path (signal-cli daemon --socket) or host:port (signal-cli daemon --tcp)
SIGNALCLI_SOCKET=/run/signal-cli/socket
# API key for the model's API (an OpenRouter key by default). With neither
# this nor MODEL_API_URL set, the bot has no model and answers only commands.
MODEL_API_KEY=
# Base URL of another OpenAI-compatible chat completions API, e.g. a local
# Ollama at http://localhost:11434/v1 (see README)
#MODEL_API_URL=https://openrouter.ai/api/v1
# The model's name at the API; on OpenRouter as provider/model
#MODEL=deepseek/deepseek-v4.1-flash-1017
# Reasoning effort: none, low, medium or high
MODEL_REASONING=low
MODEL_SEARCH=true
# Signal UUIDs/numbers allowed to DM the bot, separated by commas or whitespace
SIGNAL_DM_USER_IDS=
# Extra instructions, appended to the built-in prompt
MODEL_SYSTEM_PROMPT=

# Optional
#INTRO=hi, I'm {name}, your open source assistant running {model} (tools: {tools}).
#MAX_CONCURRENCY=32
#HISTORY_TURNS=10
# Remember group messages not addressed to the bot, as context
#GROUP_CONTEXT=true
# MCP servers file (see README)
#MCP_CONFIG=
