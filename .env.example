# Unix socket path (signal-cli daemon --socket) or host:port (signal-cli daemon --tcp)
SIGNALCLI_SOCKET=/run/signal-cli/socket
XAI_API_KEY=
MODEL=grok-4.3
REASONING=low
XAI_SEARCH=true
# Comma-separated Signal UUIDs/numbers allowed to DM the bot
SIGNAL_ALLOWED_SENDERS=
# Optional: SYSTEM_PROMPT, MAX_CONCURRENCY=32, HISTORY_TURNS=10
