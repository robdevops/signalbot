# Unix socket path (signal-cli daemon --socket) or host:port (signal-cli daemon --tcp)
SIGNALCLI_SOCKET=/run/signal-cli/socket
# Set exactly one of XAI_API_KEY and OPENROUTER_API_KEY
XAI_API_KEY=
#OPENROUTER_API_KEY=
# Defaults: grok-4.3 for x.ai, deepseek/deepseek-v4.1-flash-1017 for OpenRouter (which wants provider/model)
#MODEL=
REASONING=low
XAI_SEARCH=true
#OPENROUTER_SEARCH=false
# Signal UUIDs/numbers allowed to DM the bot, separated by commas or whitespace
SIGNAL_DM_USER_IDS=
# Extra instructions, appended to the built-in prompt
SYSTEM_PROMPT=

# Optional
#INTRO=hi, I'm {name}, your open source assistant running {model}.
#XAI_PRICE_IN=1.25
#XAI_PRICE_CACHED=0.20
#XAI_PRICE_OUT=2.50
#MAX_CONCURRENCY=32
#HISTORY_TURNS=10
