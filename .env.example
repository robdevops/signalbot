# Unix socket path (signal-cli daemon --socket) or host:port (signal-cli daemon --tcp)
SIGNALCLI_SOCKET=/run/signal-cli/socket
XAI_API_KEY=
MODEL=grok-4.3
REASONING=low
XAI_SEARCH=true
# Signal UUIDs/numbers allowed to DM the bot, separated by commas or whitespace
SIGNAL_DM_USER_IDS=
# Extra instructions, appended to the built-in prompt
SYSTEM_PROMPT=
# Also log message text, not just who sent it
LOG_MESSAGE_BODY=false

# Optional
#INTRO=hi, I'm {name}, your open source assistant running {model}.
#XAI_PRICE_IN=1.25
#XAI_PRICE_CACHED=0.20
#XAI_PRICE_OUT=2.50
#MAX_CONCURRENCY=32
#HISTORY_TURNS=10
