[Unit]
After=network-online.target signal-cli.service
Description=Signal LLM chat bot
Wants=network-online.target

[Service]
# A transient user: it reaches signal-cli's socket as a member of the
# signal-cli group (SupplementaryGroups), so nothing needs to know its uid.
DynamicUser=yes
EnvironmentFile=/etc/signalbot.env
ExecStart=/usr/local/bin/signalbot
Restart=on-failure
RestartSec=10s
StandardError=journal
StandardOutput=journal
SupplementaryGroups=signal-cli
SyslogIdentifier=signalbot

# Filesystem
InaccessiblePaths=/boot /media /mnt
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
UMask=0077

# Privileges
AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service

# Kernel
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes

# Process isolation
ProcSubset=pid
ProtectProc=invisible
RestrictNamespaces=yes

# Network: the signal-cli socket, plus HTTPS to LLM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resources
MemoryAccounting=yes
MemoryHigh=200M
MemoryMax=300M
TasksMax=64

[Install]
WantedBy=multi-user.target
