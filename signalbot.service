[Unit]
After=network-online.target signal-cli.service
Description=Signal LLM chat bot
Wants=network-online.target

[Service]
# A transient user. It reaches signal-cli over TCP on 127.0.0.1:7583; for the
# Unix socket instead (docs/SOCKET.md), uncomment SupplementaryGroups below, so
# it joins the signal-cli group and nothing needs to know its uid.
DynamicUser=yes
EnvironmentFile=/etc/signalbot.env
# MCP connectors: the servers file (start from examples/signalbot-mcp.json),
# readable by this service only
#LoadCredential=mcp.json:/etc/signalbot-mcp.json
#Environment=MCP_CONFIG=%d/mcp.json
ExecStart=/usr/local/bin/signalbot
# The bot's saved state: /var/lib/private/signalbot, as $STATE_DIRECTORY
StateDirectory=signalbot
Restart=on-failure
RestartSec=10s
StandardError=journal
StandardOutput=journal
#SupplementaryGroups=signal-cli
SyslogIdentifier=signalbot

# Filesystem
InaccessiblePaths=/boot /media /mnt
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
UMask=0077

# Privileges
AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service

# Kernel
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes

# Process isolation
ProcSubset=pid
ProtectProc=invisible
RestrictNamespaces=yes

# Network: signal-cli (TCP, or its Unix socket), plus the model's API
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resources
MemoryAccounting=yes
MemoryHigh=400M
MemoryMax=512M
# Go collects garbage harder as it nears this, well before MemoryMax
Environment=GOMEMLIMIT=360MiB
# Never swap, so conversation history cannot reach disk
MemorySwapMax=0
# No core dumps, which would write conversation history and the API key to disk
LimitCORE=0
TasksMax=64

[Install]
WantedBy=multi-user.target
