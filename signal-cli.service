[Unit]
Description=signal-cli daemon
After=network-online.target
Wants=network-online.target

[Service]
# Edit the account number, and the path if signal-cli is installed elsewhere.
ExecStart=/usr/local/bin/signal-cli --config /var/lib/signal-cli -a +1234567890 daemon --socket /run/signal-cli/socket
Restart=on-failure
RestartSec=10s
User=signal-cli
Group=signal-cli

# Account data: /var/lib/signal-cli, private to signal-cli.
StateDirectory=signal-cli
StateDirectoryMode=0700

# The socket. The directory is searchable by the signal-cli group, and UMask
# makes the socket itself group-writable, so anything in that group can
# connect: the signalbot unit (SupplementaryGroups=signal-cli) and Docker
# (--group-add). Nobody else can.
RuntimeDirectory=signal-cli
RuntimeDirectoryMode=0750
UMask=0007

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
